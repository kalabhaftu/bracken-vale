<!--
THESIS: A local record shelf that makes finding and playing tracks the primary task.
OWN-WORLD: Windows theme resources, Segoe UI and native Fluent controls; optional artwork-derived accent.
STORY: Find a library view, search it, play a track, then save playlists and listening state locally.
FIRST VIEWPORT: Reorderable library destinations at left, searchable sortable tracks in the center, persistent player at the bottom.
FORM: Native WinUI NavigationView and virtualized ListView; two accent treatments are switchable in Settings.
-->
<Window
    x:Class="BrackenVale.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:BrackenVale.Core"
    xmlns:local="using:BrackenVale.App"
    Title="Bracken Vale">
    <Grid x:Name="ShellRoot" RowDefinitions="*,112" MinWidth="680" MinHeight="520" SizeChanged="ShellRoot_SizeChanged">
        <NavigationView x:Name="NavView" Grid.Row="0" IsSettingsVisible="False" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        SelectionChanged="NavView_SelectionChanged" IsPaneToggleButtonVisible="True" OpenPaneLength="224" CompactPaneLength="52">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Songs" Tag="Songs"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="Albums"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="Artists"><NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Genres" Tag="Genres"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Folders" Tag="Folders"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="Favorites"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Most Played" Tag="Most Played"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Recently Played" Tag="Recently Played"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Recently Added" Tag="Recently Added"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Playlists" Tag="Playlists"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93A;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Now Playing" Tag="Now Playing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid Margin="20,16,20,12" RowDefinitions="Auto,Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SearchBox" PlaceholderText="Search songs, artists, albums, folders" MaxWidth="420" HorizontalAlignment="Stretch"
                                 TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search your music library" />
                        <Button x:Name="AddFolderButton" Grid.Column="1" Content="Add folder" Click="AddFolder_Click" />
                        <Button x:Name="ManageRootsButton" Grid.Column="2" Content="Library folders" Click="ManageRoots_Click" AutomationProperties.Name="Manage music library folders" />
                        <Button x:Name="ScanLibraryButton" Grid.Column="3" Content="Scan library" Click="Scan_Click" />
                        <Button Grid.Column="4" x:Name="ScanPauseButton" Content="Pause scan" Click="ScanPause_Click" Visibility="Collapsed" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,22,0,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel>
                            <TextBlock x:Name="ViewTitle" Text="Songs" TextTrimming="CharacterEllipsis" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="TrackCountText" Text="Your library" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="SortBox" Grid.Column="1" Header="Sort by" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" MinWidth="130">
                            <ComboBoxItem Content="Title" /><ComboBoxItem Content="Artist" /><ComboBoxItem Content="Album" /><ComboBoxItem Content="Genre" />
                            <ComboBoxItem Content="Year" /><ComboBoxItem Content="Recently added" /><ComboBoxItem Content="Duration" /><ComboBoxItem Content="Play count" />
                            <ComboBoxItem Content="Last played" /><ComboBoxItem Content="File path" /><ComboBoxItem Content="Rating" />
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Grid.Column="2" Content="Ascending" VerticalAlignment="Bottom" Click="SortDirection_Click" />
                    </Grid>
                    <Grid x:Name="LibraryView" Grid.Row="2" RowDefinitions="32,*,Auto" ColumnDefinitions="240,*">
                        <TextBlock x:Name="GroupHeading" Text="Browse" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Grid x:Name="TrackHeader" Grid.Column="1" Margin="12,0" ColumnDefinitions="48,2*,*,*,72,76,50,48">
                            <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Album" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Year" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Rating" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="Time" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <ListView x:Name="GroupList" Grid.Row="1" SelectionMode="Single" SelectionChanged="GroupList_SelectionChanged" AutomationProperties.Name="Library groups" />
                        <ListView x:Name="TrackList" Grid.Row="1" Grid.Column="1" IsItemClickEnabled="False" SelectionMode="Single" DoubleTapped="TrackList_DoubleTapped" KeyDown="TrackList_KeyDown" AutomationProperties.HelpText="Select a track and press Enter or double-click to play it."
                                  SelectionChanged="TrackList_SelectionChanged" AutomationProperties.Name="Music tracks">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:Track">
                                    <Grid Margin="6,4" ColumnDefinitions="48,2*,*,*,72,76,50,48" MinHeight="54" AutomationProperties.Name="{x:Bind Title}">
                                        <Image Width="40" Height="40" Stretch="UniformToFill" Tag="{x:Bind ArtworkPath}" Loaded="Artwork_Loaded" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Artist}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Year}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <Button Grid.Column="5" Content="{x:Bind RatingDisplay}" Tag="{x:Bind Path}" Click="Rating_Click" ToolTipService.ToolTip="Set track rating" AutomationProperties.Name="Set rating" AutomationProperties.ItemStatus="{x:Bind RatingDisplay}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Duration}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <ToggleButton Grid.Column="7" IsChecked="{x:Bind Favorite, Mode=OneWay}" Tag="{x:Bind Path}" Click="Favorite_Click" ToolTipService.ToolTip="Toggle favorite" AutomationProperties.Name="Favorite">
                                            <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" />
                                        </ToggleButton>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Play next" Tag="{x:Bind Path}" Click="PlayNext_Click" />
                                                <MenuFlyoutItem Text="Add to playlist" Tag="{x:Bind Path}" Click="AddToPlaylist_Click" />
                                                <MenuFlyoutItem Text="Edit tags" Tag="{x:Bind Path}" Click="EditTags_Click" />
                                                <MenuFlyoutItem Text="Restore previous tags" Tag="{x:Bind Path}" Click="RestoreTags_Click" />
                                                <MenuFlyoutItem Text="Lyrics" Tag="{x:Bind Path}" Click="Lyrics_Click" />
                                                <MenuFlyoutItem Text="Track details" Tag="{x:Bind Path}" Click="Details_Click" />
                                                <MenuFlyoutItem Text="Show in File Explorer" Tag="{x:Bind Path}" Click="ShowInFolder_Click" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Your music will appear here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Add a folder or let Bracken Vale scan your fixed drives." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <Button Content="Add a music folder" Click="AddFolder_Click" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="LibraryPager" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                            <Button x:Name="PreviousPageButton" Content="Previous" Click="PreviousPage_Click" AutomationProperties.Name="Show previous library page" />
                            <TextBlock x:Name="PageStatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            <Button x:Name="NextPageButton" Content="Next" Click="NextPage_Click" AutomationProperties.Name="Show next library page" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="NowPlayingView" Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="36" Visibility="Collapsed">
                        <StackPanel x:Name="NowPlayingArtworkPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <Image x:Name="NowPlayingArtwork" Width="320" Height="320" Stretch="UniformToFill" />
                            <TextBlock x:Name="NowPlayingTitle" Text="Nothing is playing" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NowPlayingArtist" Text="Choose a song from your library" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Grid x:Name="NowPlayingLyricsPanel" Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="0,36">
                            <TextBlock Text="Lyrics" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ScrollViewer Grid.Row="1" Margin="0,16">
                                <TextBlock x:Name="NowPlayingLyrics" Text="Lyrics can be opened and saved as .lrc sidecar files." TextWrapping="Wrap" FontSize="20" LineHeight="34" />
                            </ScrollViewer>
                            <Button Grid.Row="2" Content="Open lyrics" HorizontalAlignment="Left" Click="OpenLyrics_Click" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="PlaylistView" Grid.Row="2" Visibility="Collapsed" ColumnDefinitions="240,*" ColumnSpacing="16">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                <Button Content="New playlist" Click="NewPlaylist_Click" />
                                <Button Content="Import" Click="ImportPlaylist_Click" AutomationProperties.Name="Import an M3U8 playlist" />
                            </StackPanel>
                        <ListView x:Name="PlaylistList" Grid.Row="1" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name" AutomationProperties.Name="Your playlists" />
                        </Grid>
                        <Grid x:Name="PlaylistDetailView" Grid.Column="1" RowDefinitions="Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="PlaylistDetailTitle" Text="Choose a playlist" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PlaylistDetailCount" Text="Your playlists are stored on this PC." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="RenamePlaylistButton" Grid.Column="1" Content="Rename" Click="RenamePlaylist_Click" IsEnabled="False" />
                                <Button x:Name="ExportPlaylistButton" Grid.Column="2" Content="Export" Click="ExportPlaylist_Click" IsEnabled="False" />
                                <Button x:Name="DeletePlaylistButton" Grid.Column="3" Content="Delete" Click="DeletePlaylist_Click" IsEnabled="False" />
                                <Button x:Name="PlayPlaylistButton" Grid.Column="4" Content="Play" Click="PlayPlaylist_Click" IsEnabled="False" AutomationProperties.Name="Play the selected playlist" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="PlaylistTrackList" DoubleTapped="PlaylistTrackList_DoubleTapped" KeyDown="PlaylistTrackList_KeyDown" AutomationProperties.Name="Tracks in the selected playlist" AutomationProperties.HelpText="Select a track and press Enter or double-click to play it.">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PlaylistTrackRow">
                    <Grid Margin="6,4" ColumnDefinitions="48,2*,*,*,72,Auto" MinHeight="52" AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Image Width="40" Height="40" Stretch="UniformToFill" Tag="{x:Bind ArtworkPath}" Loaded="Artwork_Loaded" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Album}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind TrackPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Tag="{x:Bind Entry.Position}" Click="RemoveFromPlaylist_Click" ToolTipService.ToolTip="Remove this track from the playlist" AutomationProperties.Name="Remove this occurrence from the playlist">
                                            <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                                <StackPanel x:Name="PlaylistEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Visible">
                                    <TextBlock x:Name="PlaylistEmptyTitle" Text="Select a playlist" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="PlaylistEmptyMessage" Text="Create a playlist or choose one from the list." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="PlaylistPager" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                                <Button Content="Previous" Click="PreviousPage_Click" AutomationProperties.Name="Show previous playlist page" />
                                <TextBlock x:Name="PlaylistPageStatusText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button Content="Next" Click="NextPage_Click" AutomationProperties.Name="Show next playlist page" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid x:Name="ScanStatus" Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                        <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="4" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="ScanCancelButton" Content="Cancel" Click="ScanCancel_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="680" Margin="0,8" Spacing="4">
            <InfoBar x:Name="AppNotice" IsOpen="False" IsClosable="True" Severity="Informational" />
            <InfoBar x:Name="ReleaseNotice" IsOpen="False" IsClosable="True" Severity="Informational" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid x:Name="PlayerBarGrid" Margin="14,8" ColumnDefinitions="200,*,240" ColumnSpacing="12">
                <StackPanel x:Name="PlayerTrackInfo" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="PlayerTitle" Text="Bracken Vale" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PlayerArtist" Text="Choose a song to begin" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid x:Name="TransportControlsGrid" Grid.Column="1" RowDefinitions="Auto,Auto">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <ToggleButton x:Name="ShuffleButton" Content="Shuffle" Click="Shuffle_Click" IsChecked="False" AutomationProperties.Name="Shuffle" AutomationProperties.ItemStatus="Off" />
                        <Button Content="Previous" Click="Previous_Click" AutomationProperties.Name="Previous track" />
                        <ToggleButton x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" IsChecked="False" AutomationProperties.Name="Resume playback" AutomationProperties.ItemStatus="Paused" />
                        <Button Content="Next" Click="Next_Click" AutomationProperties.Name="Next track" />
                        <Button Content="Repeat: Off" x:Name="RepeatButton" Click="Repeat_Click" AutomationProperties.Name="Change repeat mode" />
                        <ToggleButton x:Name="AbRepeatButton" Content="A–B" Click="AbRepeat_Click" IsThreeState="True" IsChecked="False" AutomationProperties.Name="A–B repeat" AutomationProperties.ItemStatus="Off" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="48,*,48" ColumnSpacing="8">
                        <TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="SeekSlider_ValueChanged" IsEnabled="False" AutomationProperties.Name="Track position" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
                <StackPanel x:Name="PlayerUtilities" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                    <Button x:Name="QueueButton" Click="Queue_Click" AutomationProperties.Name="Show playback queue" ToolTipService.ToolTip="Show playback queue">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" />
                            <TextBlock x:Name="QueueButtonLabel" Text="Queue" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EqualizerButton" Click="Equalizer_Click" AutomationProperties.Name="Open equalizer" ToolTipService.ToolTip="Open equalizer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9E9;" FontFamily="Segoe MDL2 Assets" />
                            <TextBlock x:Name="EqualizerButtonLabel" Text="Equalizer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VolumeLabel" Text="Volume" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="75" ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
